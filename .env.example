# Red Bibosi — plantilla de variables de entorno.
# Copia este archivo a .env.local (nunca lo subas a Git) y completa los valores.
# En Vercel, carga las mismas claves en Project Settings → Environment Variables.

# PÚBLICA (llega al navegador): URL del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# PÚBLICA (llega al navegador): clave anónima / publishable. Respeta RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA (solo servidor): service role. Nunca uses el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
