# Copia a .env.local y completa. Nunca commits valores reales.

# Supabase (público / browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (solo servidor — no prefijar NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# live (default) | mock
NEXT_PUBLIC_API_MODE=live

# Solo desarrollo local: permite X-Mock-User-Id (NUNCA en Vercel Production)
# ALLOW_MOCK_AUTH=true
# NEXT_PUBLIC_ALLOW_MOCK_AUTH=true
